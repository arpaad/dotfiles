# ~/.config/theme/palette.env  ·  managed in ~/.dotfiles, symlinked by stow
#
# ONE source of truth for colour across the whole toolset.
#
# Theme: Tokyo Night Moon.
#
# Why this one: tokyonight.nvim is LazyVim's default colorscheme, and upstream
# ships hand-generated themes for bat, yazi, fzf, delta, tmux, lazygit and btop
# in its own `extras/` directory. So every tool is themed by the theme's own
# author from one palette, rather than by me guessing at equivalents.
# scripts/04-theme.sh copies those into place.
#
# Format is deliberately dumb — KEY="value", one per line, no logic — so zsh can
# source it, scripts/04-theme.sh can source it, and Neovim can read it with a
# few lines of Lua.
#
# ---------------------------------------------------------------------------
# To re-theme everything:
#   1. change THEME_NVIM to any colorscheme LazyVim can load
#   2. if it ships extras/ like tokyonight does, point 04-theme.sh at them;
#      otherwise set THEME_BAT / THEME_YAZI to that theme's own names
#   3. repoint the C_* palette below (the ROLE_* block then follows)
#   4. run scripts/04-theme.sh && open a new shell
# ---------------------------------------------------------------------------
#
# Who reads what:
#   THEME_BAT   → $BAT_THEME in .zshrc — used by bat AND delta (delta follows it)
#   THEME_NVIM  → nvim/…/lua/plugins/colorscheme.lua
#   ROLE_*      → generated into eza/.config/eza/theme.yml by 04-theme.sh
#   C_*         → reference; the generated fragments in this directory use them

# --- which named theme each tool uses ---------------------------------------
THEME_NAME="Tokyo Night Moon"
THEME_BAT="tokyonight_moon"     # bat names a custom theme after its FILENAME, not the
                                # <name> inside the .tmTheme. Check: bat --list-themes
THEME_NVIM="tokyonight-moon"
THEME_TOKYONIGHT_STYLE="moon"   # which extras/ variant 04-theme.sh copies

# --- the palette ------------------------------------------------------------
# Tokyo Night Moon, taken verbatim from the installed plugin. Re-derive with:
#   nvim --headless -c 'lua print(vim.inspect(require("tokyonight.colors").setup({style="moon"})))' -c qa
C_RED="#ff757f"
C_RED_DARK="#c53b53"
C_ORANGE="#ff966c"
C_YELLOW="#ffc777"
C_GREEN="#c3e88d"
C_TEAL="#4fd6be"
C_TEAL_DARK="#41a6b5"
C_CYAN="#86e1fc"
C_BLUE="#82aaff"
C_BLUE_LIGHT="#65bcff"
C_BLUE_PALE="#89ddff"
C_BLUE_ICE="#b4f9f8"
C_MAGENTA="#c099ff"
C_MAGENTA_HOT="#ff007c"
C_PURPLE="#fca7ea"
C_FG="#c8d3f5"
C_FG_DARK="#828bb8"
C_GREY="#737aa2"
C_GREY_DARK="#545c7e"
C_GUTTER="#3b4261"
C_BG="#222436"
C_BG_DARK="#1e2030"
C_BG_HIGHLIGHT="#2f334d"

# --- roles: what a colour MEANS ---------------------------------------------
# This is the layer that makes a re-theme survive. `ls` does not care that
# config files are orange; it cares that they are ROLE_CONFIG. Repoint these at
# a different palette and the meaning carries over intact.
#
# Full explanation of the scheme: docs/theme/eza-colours.md
ROLE_DIR="$C_BLUE"             # a place you can go
ROLE_LINK="$C_BLUE_ICE"        # a pointer, not the thing
ROLE_MOUNT="$C_TEAL_DARK"      # another filesystem
ROLE_RUN="$C_GREEN"            # it executes
ROLE_CODE="$C_YELLOW"          # source you write
ROLE_CONFIG="$C_ORANGE"        # decides how something behaves
ROLE_DATA="$C_CYAN"            # content, not code and not config
ROLE_PROSE="$C_MAGENTA"        # meant to be read
ROLE_ARCHIVE="$C_TEAL"         # a sealed container
ROLE_MEDIA="$C_PURPLE"         # images, video, audio
ROLE_DANGER="$C_RED"           # secrets, breakage, hazards
ROLE_ALARM="$C_MAGENTA_HOT"    # the loudest thing available: world-writable, setuid
ROLE_DEVICE="$C_RED_DARK"      # block / char devices
ROLE_PLAIN="$C_FG"             # an ordinary file with nothing to say
ROLE_MUTED="$C_FG_DARK"        # present but uninformative
ROLE_IGNORE="$C_GREY"          # machine-owned: do not read, do not edit
ROLE_FAINT="$C_GREY_DARK"      # structure, separators, absence
ROLE_HEADER="$C_FG_DARK"       # column titles

# Tokyo Night has no third distinguishable pink, so images, video and audio
# share ROLE_MEDIA rather than pretending to differ. Catppuccin Frappé could
# separate them; this palette buys a wider spread elsewhere instead.

# --- version-control states (kept aligned with how a diff reads) ------------
ROLE_ADDED="$C_GREEN"
ROLE_CHANGED="$C_YELLOW"
ROLE_REMOVED="$C_RED"
ROLE_MOVED="$C_BLUE_LIGHT"
