[user]
	name = Luckyman42
	email = arpad2000@gmail.com

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

# delta's colours, generated by scripts/04-theme.sh from the same palette as
# everything else. Listed last so its styles win; the [delta] block above keeps
# the behaviour settings.
[include]
	path = ~/.config/theme/delta.gitconfig
